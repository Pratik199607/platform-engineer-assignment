[Unit]
Description=Platform FastAPI Application
Documentation=https://fastapi.tiangolo.com/
After=network.target


[Service]

Type=simple

User=platform
Group=platform

WorkingDirectory=/opt/platform/current

EnvironmentFile=/etc/platform/platform.env

ExecStart=/opt/platform/current/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always

RestartSec=5

TimeoutStopSec=30

KillSignal=SIGTERM

NoNewPrivileges=true

PrivateTmp=true

ProtectSystem=full

ProtectHome=true


[Install]

WantedBy=multi-user.target